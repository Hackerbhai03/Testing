# from my.telegram.org/apps
API_ID=
API_HASH=

# from @BotFather on telegram
BOT_TOKEN=
LOGGER_ID=

# mongo url from cloud.mongodb.com
MONGO_URL=

OWNER_ID=

# pyrogram session from @StringFatherBot on telegram
SESSION=

# --- optional audio tuning ---
# native = YouTube's own Opus stream, no ffmpeg re-encode (smallest + clearest). ffmpeg = old re-encode to Opus 128k.
AUDIO_BACKEND=native
# max MB kept in downloads/ (oldest unused files are auto-deleted, 0 = unlimited)
CACHE_LIMIT_MB=300
